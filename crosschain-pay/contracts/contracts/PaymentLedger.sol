pragma solidity ^0.8.20;

/**
 * @title PaymentLedger
 * @notice CrossChain Pay Smart Contract for Recording Cross-Border Payment Metadata on Blockchain.
 * @dev Educational prototype for auditable and tamper-resistant payment record coordination.
 */
contract PaymentLedger {
    address public owner;

    enum PaymentStatus {
        Recorded,
        Settled,
        Failed
    }

    struct PaymentRecord {
        string paymentId;
        address sender;
        string beneficiary;
        string destinationCountry;
        string destinationCurrency;
        uint256 amount;          // Stored in standard integer scale (e.g. cents/wei)
        uint256 timestamp;
        PaymentStatus status;
        bool exists;
    }

    // Mapping from paymentId to PaymentRecord
    mapping(string => PaymentRecord) private payments;

    // Array of all payment IDs for enumeration and audit
    string[] private paymentIds;

    // Events
    event PaymentRecorded(
        string indexed paymentId,
        address indexed sender,
        string beneficiary,
        string destinationCountry,
        string destinationCurrency,
        uint256 amount,
        uint256 timestamp
    );

    event PaymentStatusUpdated(
        string indexed paymentId,
        PaymentStatus newStatus,
        uint256 timestamp
    );

    modifier onlyOwner() {
        require(msg.sender == owner, "PaymentLedger: Caller is not owner");
        _;
    }

    constructor() {
        owner = msg.sender;
    }

    /**
     * @notice Records a new cross-border payment on the blockchain ledger.
     * @param paymentId Unique transaction ID generated by payment rail
     * @param beneficiary Name or identifier of receiving party
     * @param destinationCountry ISO destination country code (e.g. 'USA', 'IND', 'GBR')
     * @param destinationCurrency 3-letter currency code (e.g. 'INR', 'EUR', 'GBP')
     * @param amount Positive payment amount
     */
    function recordPayment(
        string memory paymentId,
        string memory beneficiary,
        string memory destinationCountry,
        string memory destinationCurrency,
        uint256 amount
    ) external returns (bool) {
        require(bytes(paymentId).length > 0, "PaymentLedger: Payment ID cannot be empty");
        require(bytes(beneficiary).length > 0, "PaymentLedger: Beneficiary cannot be empty");
        require(bytes(destinationCountry).length > 0, "PaymentLedger: Destination country cannot be empty");
        require(bytes(destinationCurrency).length > 0, "PaymentLedger: Destination currency cannot be empty");
        require(amount > 0, "PaymentLedger: Amount must be greater than zero");
        require(!payments[paymentId].exists, "PaymentLedger: Payment ID already recorded");

        PaymentRecord memory newRecord = PaymentRecord({
            paymentId: paymentId,
            sender: msg.sender,
            beneficiary: beneficiary,
            destinationCountry: destinationCountry,
            destinationCurrency: destinationCurrency,
            amount: amount,
            timestamp: block.timestamp,
            status: PaymentStatus.Recorded,
            exists: true
        });

        payments[paymentId] = newRecord;
        paymentIds.push(paymentId);

        emit PaymentRecorded(
            paymentId,
            msg.sender,
            beneficiary,
            destinationCountry,
            destinationCurrency,
            amount,
            block.timestamp
        );

        return true;
    }

    /**
     * @notice Retrieves payment metadata by payment ID.
     */
    function getPayment(string memory paymentId)
        external
        view
        returns (
            string memory id,
            address sender,
            string memory beneficiary,
            string memory destinationCountry,
            string memory destinationCurrency,
            uint256 amount,
            uint256 timestamp,
            PaymentStatus status
        )
    {
        require(payments[paymentId].exists, "PaymentLedger: Payment not found");
        PaymentRecord memory p = payments[paymentId];
        return (
            p.paymentId,
            p.sender,
            p.beneficiary,
            p.destinationCountry,
            p.destinationCurrency,
            p.amount,
            p.timestamp,
            p.status
        );
    }

    /**
     * @notice Verifies if a transaction exists on-chain and returns integrity status.
     */
    function verifyPayment(string memory paymentId)
        external
        view
        returns (
            bool exists,
            address sender,
            uint256 timestamp,
            PaymentStatus status
        )
    {
        if (!payments[paymentId].exists) {
            return (false, address(0), 0, PaymentStatus.Failed);
        }
        PaymentRecord memory p = payments[paymentId];
        return (true, p.sender, p.timestamp, p.status);
    }

    /**
     * @notice Returns total number of recorded cross-border payments.
     */
    function getPaymentCount() external view returns (uint256) {
        return paymentIds.length;
    }

    /**
     * @notice Returns payment ID at index.
     */
    function getPaymentIdByIndex(uint256 index) external view returns (string memory) {
        require(index < paymentIds.length, "PaymentLedger: Index out of bounds");
        return paymentIds[index];
    }

    /**
     * @notice Updates payment status (e.g. from Recorded to Settled).
     */
    function updateStatus(string memory paymentId, PaymentStatus newStatus) external onlyOwner {
        require(payments[paymentId].exists, "PaymentLedger: Payment does not exist");
        payments[paymentId].status = newStatus;
        emit PaymentStatusUpdated(paymentId, newStatus, block.timestamp);
    }
}
